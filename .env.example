# PHANTOM frontend
VITE_PHANTOM_API_URL=http://localhost:8000

# PHANTOM backend
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/phantom
PHANTOM_REDIS_URL=redis://localhost:6379/0
PHANTOM_CORS_ORIGINS=http://localhost:5173
PHANTOM_AUTH_SECRET=replace-with-a-long-random-secret
PHANTOM_BOOTSTRAP_EMAIL=admin@phantom.local
PHANTOM_BOOTSTRAP_PASSWORD=replace-before-use
PHANTOM_BOOTSTRAP_ROLE=owner
PHANTOM_ENV=development
PHANTOM_SESSION_HOURS=12
PHANTOM_WS_TICKET_TTL_SECONDS=60

# Scan safety limits
PHANTOM_SCAN_MODULE_TIMEOUT_SECONDS=120
PHANTOM_SCAN_TOTAL_TIMEOUT_SECONDS=900
PHANTOM_SCAN_MAX_MODULES=32
PHANTOM_MAX_CONCURRENT_SCANS=2
PHANTOM_SCAN_REQUEST_BUDGET=250
PHANTOM_SCAN_MAX_REDIRECTS=3
PHANTOM_SCAN_HTTP_TIMEOUT_SECONDS=8
PHANTOM_SCAN_CONNECT_TIMEOUT_SECONDS=5
PHANTOM_SCAN_MAX_RESPONSE_BYTES=2097152

# Worker reliability
PHANTOM_JOB_LEASE_SECONDS=900
PHANTOM_MAX_JOB_ATTEMPTS=3
PHANTOM_WORKER_HEARTBEAT_TTL=30
